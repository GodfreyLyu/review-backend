ENVIRONMENT=local
DEPLOYMENT_ENVIRONMENT=development
SIGNING_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://review:local-test-password@127.0.0.1:55432/review_backend
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
API_HOST=127.0.0.1
API_PORT=8080
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:59092
KAFKA_TOPIC=review.jobs.v1
KAFKA_DLQ_TOPIC=review.jobs.dlq.v1
KAFKA_GROUP_ID=review-worker-v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_USERNAME=review-worker
# KAFKA_SASL_PASSWORD=configure-in-secret-store
# KAFKA_SSL_CA_LOCATION=/run/secrets/kafka-ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/run/secrets/kafka-client.pem
# KAFKA_SSL_KEY_LOCATION=/run/secrets/kafka-client.key
THRIFT_HOST=127.0.0.1
THRIFT_PORT=9091
THRIFT_SOCKET_TIMEOUT_SECONDS=2
THRIFT_RECOVERY_SECONDS=20
MODEL_MAX_OUTPUT_TOKENS=384
INFERENCE_TIMEOUT_SECONDS=300
QUEUE_CAPACITY=8
MAX_ACTIVE_PER_USER=1
TASK_DEADLINE_SECONDS=600
WORKER_LEASE_SECONDS=30
RELAY_LEASE_SECONDS=30
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=30
MAX_RETRIES=2
MAX_RECOVERY_ATTEMPTS=8
START_WATCHDOG_SECONDS=60
SHUTDOWN_GRACE_SECONDS=20
ENABLE_API_DOCS=false
# In production use DATABASE_URL sslmode=verify-full with a trusted CA, secure cookies,
# encrypted Kafka, and a local mTLS sidecar for Thrift (see inference contract docs).
