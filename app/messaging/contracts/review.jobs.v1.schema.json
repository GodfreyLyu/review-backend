{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.jobs.v1",
  "title": "Backend Review Job Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "review_id", "trace_id", "schema_version", "execution_version", "attempt", "created_at"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "review_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "format": "uuid"},
    "schema_version": {"const": 1},
    "execution_version": {"const": "review-v1"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 1000},
    "created_at": {"type": "number", "exclusiveMinimum": 0},
    "reason": {"type": "string", "maxLength": 100}
  }
}
